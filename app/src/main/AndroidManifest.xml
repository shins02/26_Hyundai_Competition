<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량용(Android Automotive OS) 앱 -->
    <!-- release는 차량 전용(true), debug는 일반 에뮬레이터에서도 화면 확인이 되도록 false -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="${automotiveRequired}" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Vehicle SDK: 모두 읽기 권한만 사용합니다 (CONTROL_CAR_* 없음) -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 경고등(Telltale: 운전자 주의 경고) 읽기는 PRIVATE_CAR_SAFETY가 있어야 합니다 (Pleos 에뮬레이터 v2.1.0에서 확인) -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- NaviHelper: 현재 위치 정보 조회, 경유지 추가 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 음성 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Gilstory">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- 주행 중 사용 가능한 화면으로 선언 (화면은 아이콘·한 줄·큰 버튼만 사용) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
